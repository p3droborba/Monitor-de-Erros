# ============================================================
# IDENTIFICAÇÃO E SAÍDA
# ============================================================
APP_NAME=coletor_saas
OUTPUT_DIR=./saida
LOG_LEVEL=INFO
INTERVAL_SECONDS=30
DATA_SCHEMA_DIR=./data_schema

# ============================================================
# LIGAR/DESLIGAR PARTES DO COLETOR
# ============================================================
ENABLE_HTTP=true
ENABLE_ORACLE=true
ENABLE_FUNCTIONAL_PROBES=true

# ============================================================
# HTTP
# Cada item avalia disponibilidade e também sanidade funcional.
# name              = nome amigável do teste
# url               = URL completa
# method            = GET, HEAD, OPTIONS
# expected_statuses = lista de status aceitáveis
# expected_text     = texto que DEVE existir na resposta; deixe vazio se não quiser validar conteúdo
# timeout_seconds   = timeout por requisição
# verify_ssl        = true/false
# headers           = cabeçalhos opcionais
# Dica: use um unico arquivo .url com os links separados por virgula.
# Exemplo:
# http://sistema1, https://sistema2/login, https://sistema3/api
# JSON continua opcional para casos avancados.
# ============================================================
HTTP_RETRIES=1
HTTP_BACKOFF_SECONDS=1
HTTP_TARGETS_DIR=./http_targets
HTTP_TARGETS_JSON=[]

# ============================================================
# ORACLE
# Preencher somente se quiser usar coleta de banco.
# Exemplos de DSN:
# host:1521/service_name
# host:1521/ORCLPDB1
# ORACLE_CLIENT_LIB_DIR é opcional. Preencha quando precisar de
# Oracle Instant Client para usar thick mode.
# ============================================================
ORACLE_USER=SEU_USUARIO
ORACLE_PASSWORD=SUA_SENHA
ORACLE_DSN=host:1521/service_name
ORACLE_CLIENT_LIB_DIR=
ORACLE_FETCH_LOBS=false
ORACLE_LONG_RUNNING_SECONDS=60

# ============================================================
# PROBES FUNCIONAIS
# Aqui entra o que realmente ajuda a recuperar os dados importantes.
# Cada SQL deve retornar 1 linha. Pode retornar 1 ou várias colunas.
# O resultado será salvo em JSON dentro do CSV fact_oracle_probe_results.csv.
# Use consultas leves e preferencialmente em views/tabelas de apoio.
# Dica: mantenha um arquivo .sql por probe em FUNCTIONAL_PROBES_DIR.
# ============================================================
FUNCTIONAL_PROBES_DIR=./oracle_probes
FUNCTIONAL_PROBES_JSON=[]
